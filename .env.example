# Bare hostname used by HTTPS, sign-in callbacks, and browser origin checks.
HUB_HOST=localhost
# Loopback for local preview. On a host, set this to the interface serving HTTPS.
BIND_ADDRESS=127.0.0.1
# Optional override for an existing deployment with a custom HTTPS origin.
# PUBLIC_ORIGIN=https://knowledge.example.com

# Fill these in when you register a confidential OIDC web client.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_TOKEN_AUTH=client_secret_basic

OPENAI_ANSWER_MODEL=gpt-4.1-mini
# Comma-separated public hostnames permitted for webpage ingestion.
WEB_HOSTS=
AGE_RECIPIENT=
